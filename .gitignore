# Python 运行产物：自动生成、随时可重建，永远不进仓库
__pycache__/
*.pyc

# 虚拟环境：几千个依赖文件，用 requirements 描述即可（以后会加）
.venv/

# IDE 个人配置：每人每台机器都不一样
.idea/

# 密钥与本地配置：进了 git 就是泄漏（铁律——如果哪天有了 .env，
# 它必须列在这里；现在用的是系统级环境变量，暂时没有这个文件）
.env

# 轨迹页生成物：每次运行都会产出的临时快照
trace-*.html

# Chainlit 网页端的生成物
.chainlit/
.files/

# ---------- 以下为生产级整理（2026-09-02）新增 ----------

# 构建产物：pip install / build 后出现，随时可重建
build/
dist/
*.egg-info/

# 覆盖率 / lint / 测试缓存：工具自动生成
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# 编辑器：与 .idea 同类的个人配置
.vscode/
.trae/

# 学习教材：第三方参考仓库（自带上游 LICENSE），只读参考不进本仓库
learn-workbuddy/
